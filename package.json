{
  "name": "spotify-furigana",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "description": "A Spicetify desktop extension that adds furigana to Japanese lyrics in Spotify on Windows and macOS.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:macos-overlay": "sh scripts/build-macos-overlay.sh --universal",
    "launcher-icon": "node scripts/generate-launcher-icon.mjs",
    "marketing-assets": "node scripts/generate-marketing-assets.mjs",
    "package": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "compile": "tsc --noEmit",
    "check:app": "node --check dist/spotify-furigana/index.js",
    "lint": "biome check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run compile && npm run test:coverage && npm run build && npm run check:app"
  },
  "dependencies": {
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "linkedom": "^0.18.13",
    "path-browserify": "^1.0.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
